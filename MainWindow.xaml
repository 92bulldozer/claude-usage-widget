<Window x:Class="ClaudeUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage"
        Width="280" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeave="OnMouseLeave">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="지금 새로고침" Click="OnRefreshClick" />
            <MenuItem Header="위젯 숨기기" Click="OnHideClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Skia draws straight into this image's bitmap (see MainWindow.Paint). -->
    <Image x:Name="Surface" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
</Window>
